{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/cc-guardrails-ko/secret-leak-guard.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/cc-guardrails-ko/pii-leak-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
